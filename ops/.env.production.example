# Sanitized production env checklist for Nest (Autoconnecto backend).
# Copy to backend/.env.production on the host and fill real secrets.
# Source of truth for meanings: backend/ENVIRONMENT.md
# NEVER commit real secrets.

# --- HTTP ---
PORT=3000
APP_BASE_URL=https://app.example.com
CORS_ORIGIN=https://app.example.com
PUBLIC_API_BASE_URL=https://api.example.com
PLATFORM_APP_HOSTS=app.example.com,localhost,127.0.0.1

# --- Postgres (no code defaults — required) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MQTT ---
MQTT_BROKER_URL=mqtt://emqx:1883

# --- Cognito JWT (boot-critical) ---
COGNITO_JWKS_URI=
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_USER_POOL_ID=

# --- Brevo SMTP (boot-critical for EmailModule) ---
MAIL_FROM_EMAIL=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587

# --- Brevo REST (signup OTP) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Autoconnecto
SIGNUP_OTP_HMAC_SECRET=

# --- Integration webhooks (required in production unless per-tenant secrets) ---
INTEGRATION_WEBHOOK_SECRET=

# --- Modbus (defaults on; multi-replica: enable AUTO_POLL on exactly one instance) ---
# MODBUS_MQTT_SERIAL_ENABLED=true
# MODBUS_TUNNEL_ENABLED=true
# MODBUS_TUNNEL_PORT=3075
# MODBUS_AUTO_POLL_ENABLED=true

# --- Optional queue (module registration reads process.env early; inject via Compose env) ---
# TELEMETRY_QUEUE_ENABLED=false

# --- Billing (optional) ---
# DODO_PAYMENTS_API_KEY=
# DODO_WEBHOOK_SECRET=
# DODO_PAYMENTS_ENVIRONMENT=live_mode
# BILLING_LIFECYCLE_CRON_ENABLED=false

# --- OTA (production: set S3 bucket; IAM needs s3:PutObject/GetObject/DeleteObject) ---
# OTA_ENABLED=true
# OTA_S3_BUCKET=
# OTA_STORAGE_BACKEND=s3
# OTA_MAX_UPLOAD_BYTES=104857600
# OTA_FIRMWARE_CHUNK_BYTES=16384
# OTA_NOTIFY_BATCH_SIZE=100
# AWS_REGION=ap-south-1
